# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin bootstrap/recovery password. Keep it private and use a unique 12+ character value.
# Changing this value on Render and redeploying rotates the password back to this value.
# The admin username is `admin`.
ADMIN_BOOTSTRAP_PASSWORD=

# Required on Vercel for signing secure, stateless admin sessions. Use a random value
# with at least 32 characters. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Maximum invitation image upload size in MB. Set to 4 for Vercel (function body limit).
VITE_MAX_IMAGE_UPLOAD_MB=12

# Server-only Google Apps Script web app URL used for shared RSVP and wish storage.
# Create it from Google Sheets; see DEPLOY.md.
RSVP_SCRIPT_URL=

# Private server-only key. Use the same value as the RSVP_READ_KEY Apps Script property.
RSVP_SHEET_READ_KEY=
